# Sao chép file này thành .env rồi điền giá trị thật
# cp .env.example .env

# --- Database ---
DATABASE_URL=postgresql://historiai:historiai@localhost:5432/historiai

# --- Bảo mật ---
# Sinh khoá mạnh:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS (phân tách bằng dấu phẩy, * = cho tất cả khi dev) ---
CORS_ORIGINS=*

# --- LLM (để trống = chat trả lời mock) ---
# Groq: miễn phí, không cần thẻ, nhanh nhất nhóm free. Lấy key ở console.groq.com
# Model đã so sánh trên chính persona của app: qwen3.8-27b nhanh nhất (~0,6s) và
# tiếng Việt tự nhiên nhất. gpt-oss-20b và compound-mini bịa địa danh, đã loại.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT=30
LLM_MAX_TOKENS=800
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Hệ đo lường ---
# Khoá xem số liệu: bắt buộc đặt khi deploy, nếu không thì ai biết URL
# /api/v1/analytics/dashboard cũng xem được số của nhóm.
# Sinh khoá:  python -c "import secrets; print(secrets.token_urlsafe(24))"
ANALYTICS_KEY=

# --- Nơi lưu asset 3D/video (CDN / Firebase Storage) ---
ASSET_BASE_URL=https://storage.example.com/historiai

# --- TTS ---
# "edge" = Microsoft Edge TTS: giong neural tieng Viet, MIEN PHI, khong can GPU
# "vixtts" = chay local tren GPU | "elevenlabs" = tra phi | "none" = tat
TTS_PROVIDER=edge
